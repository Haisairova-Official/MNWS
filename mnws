#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

usage() {
    python3 "$ROOT/tools/mnws_runtime.py" --help
}

if [[ "$#" -eq 1 && "$1" =~ ^-v+$ ]]; then
    exec python3 "$ROOT/tools/mnws_runtime.py" "$1"
fi

# Handle moo before help so invalid combinations never run other commands.
for argument in "$@"; do
    if [[ "$argument" == "moo" ]]; then
        exec python3 "$ROOT/tools/mnws_runtime.py" "$@"
    fi
done

# Help must not run component-changing commands (for example install -h).
if [[ "${2:-}" == "-h" || "${2:-}" == "--help" || "${2:-}" == "-?" ]]; then
    case "${1:-}" in
        desktop|taskbar) exec python3 "$ROOT/tools/mnws_runtime.py" "$1" --help ;;
        *) usage; exit 0 ;;
    esac
fi

case "${1:-help}" in
    --status)
        exec python3 "$ROOT/tools/mnws_runtime.py" "$@"
        ;;
    desktop|taskbar)
        exec python3 "$ROOT/tools/mnws_runtime.py" "$@"
        ;;
    config)
        shift
        exec python3 "$ROOT/tools/mnws-config.py" "$@"
        ;;
    check)
        exec python3 "$ROOT/tools/mnws-config.py" --check
        ;;
    build-taskbar)
        cd "$ROOT/src/niri-taskbar"
        cargo build --release --offline
        install -Dm644 target/release/libniri_taskbar.so "$HOME/.local/lib/waybar/libniri_taskbar.so"
        echo "已复制 libniri_taskbar.so 到 ~/.local/lib/waybar/"
        ;;
    restart)
        case "${2:-}" in
            taskbar)
                pkill -f '[c]onfig-bottom.jsonc' || true
                sleep 0.4
                env -u GDK_BACKEND setsid -f waybar \
                    -c "$HOME/.config/waybar/config-bottom.jsonc" \
                    -s "$HOME/.config/waybar/style-bottom.css"
                ;;
            desktop)
                exec python3 "$ROOT/tools/mnws-config.py" --restart-desktop
                ;;
            *)
                echo "用法: mnws restart taskbar|desktop" >&2
                exit 2
                ;;
        esac
        ;;
    install)
        exec bash "$ROOT/scripts/mnws-install.sh"
        ;;
    autostart)
        action="${2:-status}"
        exec python3 "$ROOT/tools/mnws-config.py" --autostart "$action"
        ;;
    layout|plugin|mplg)
        command="${1:-}"
        shift
        case "$command" in
            layout)
                exec python3 "$ROOT/tools/mnws_layout.py" "$@"
                ;;
            plugin|mplg)
                exec python3 "$ROOT/tools/mnws_plugin.py" "$@"
                ;;
        esac
        ;;
    help|-h|--help|'-?')
        usage
        ;;
    *)
        echo "未知命令: ${1:-}" >&2
        usage >&2
        exit 2
        ;;
esac
